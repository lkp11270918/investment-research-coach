{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_memo.schema.json",
  "title": "ResearchMemo",
  "type": "object",
  "required": [
    "memo_id",
    "company_profile",
    "user_mode",
    "confidence",
    "sections",
    "source_ids",
    "disclaimer"
  ],
  "additionalProperties": false,
  "properties": {
    "memo_id": {
      "type": "string"
    },
    "company_profile": {
      "type": "object"
    },
    "user_mode": {
      "type": "string",
      "enum": ["to_c", "to_b"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "sections": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["section_id", "title", "body", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string",
            "enum": [
              "company_info",
              "scope_doctrine_confidence",
              "circle_of_competence",
              "business_model",
              "key_variables",
              "financial_earnings_quality",
              "cash_flow",
              "dividend",
              "balance_sheet",
              "business_stability_moat",
              "industry_competition",
              "management_capital_allocation",
              "narrative_vs_financials",
              "sell_side_consensus_divergence",
              "valuation_margin",
              "value_trap",
              "verification_questions",
              "research_view_uncertainty",
              "sources_disclaimer"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "公司基本信息",
              "资料范围、研究准则适用性与结论置信度",
              "能力圈判断",
              "商业模式：公司靠什么赚钱",
              "核心经营变量",
              "财务质量与盈利质量",
              "现金流质量",
              "分红质量与可持续性",
              "资产负债表安全性",
              "商业模式稳定性、护城河与竞争优势",
              "行业与竞争格局",
              "管理层资本配置",
              "管理层叙事与财务现实",
              "卖方共识、核心分歧与分歧来源",
              "估值与安全边际",
              "价值陷阱与反证风险",
              "待验证问题",
              "研究观点、内部研究标签、不确定性与资料缺口",
              "来源列表与不构成投资建议声明"
            ]
          },
          "body": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "markdown": {
      "type": ["string", "null"]
    }
  }
}
