{
  "workflow_name": "value_investing_research_workflow",
  "version": "0.2.0",
  "description": "Four-agent, skill-driven value investing research training workflow.",
  "nodes": [
    {
      "id": "research_planner",
      "agent": "Research Planner Agent",
      "depends_on": [],
      "outputs": ["research_plan", "priority_questions", "required_skills", "missing_inputs"]
    },
    {
      "id": "evidence",
      "agent": "Evidence Agent",
      "depends_on": ["research_planner"],
      "outputs": ["source_documents", "evidence_items", "evidence_graph", "financial_fields"]
    },
    {
      "id": "research_analyst",
      "agent": "Research Analyst Agent",
      "depends_on": ["research_planner", "evidence"],
      "outputs": ["skill_outputs", "research_claims", "valuation_analysis", "research_judgment"]
    },
    {
      "id": "red_team_judge",
      "agent": "Red Team & Judge Agent",
      "depends_on": ["research_analyst"],
      "outputs": ["judge_decisions", "pre_memo_gate", "memo", "post_memo_gate"]
    }
  ],
  "deterministic_orchestrator": {
    "responsibilities": [
      "stage ordering and dependency checks",
      "parallel Skill execution",
      "timeouts and retries",
      "schema validation",
      "hard evidence and compliance gates",
      "persistence and versioning",
      "stop_after control"
    ],
    "memo_writing": "Memo Writing is a Skill and only receives approved or downgraded Judge decisions."
  },
  "global_rules": [
    "key facts must be traceable to source coordinates",
    "unsupported evidence cannot support a formal conclusion",
    "To C mode cannot output deterministic investment ratings",
    "missing financial data must remain null or to_be_verified",
    "generative models cannot replace deterministic financial or valuation calculations"
  ]
}
